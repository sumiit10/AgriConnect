# Server
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TRUST_PROXY=0

# MongoDB Atlas: replace username, password and cluster host with your own Atlas values.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.<cluster-id>.mongodb.net/agriconnect?retryWrites=true&w=majority&appName=AgriConnect

# Cloudinary (optional for local development; required for direct image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

